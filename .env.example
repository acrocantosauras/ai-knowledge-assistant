APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_PORT=8000
APP_DATABASE_URL=postgresql+asyncpg://ai_knowledge_user:ai_knowledge_password@localhost:5432/ai_knowledge_assistant
APP_TEST_DATABASE_URL=postgresql+asyncpg://ai_knowledge_user:ai_knowledge_password@localhost:5432/ai_knowledge_assistant_test
APP_DATABASE_ECHO=false
APP_JWT_SECRET_KEY=change-me-to-a-random-secret-key
APP_JWT_ALGORITHM=HS256
APP_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Embedding configuration
APP_EMBEDDING_PROVIDER=mock
APP_EMBEDDING_MODEL=text-embedding-3-small
APP_EMBEDDING_DIMENSION=1536
APP_OPENAI_API_KEY=
APP_LOCAL_EMBEDDING_MODEL_PATH=

# Chunking configuration
APP_CHUNK_SIZE=500
APP_CHUNK_OVERLAP=100

# LLM configuration
APP_LLM_PROVIDER=mock
APP_LLM_MODEL=gpt-4o-mini
APP_LLM_TEMPERATURE=0.7
APP_LLM_MAX_TOKENS=1024
APP_LLM_TIMEOUT=60

# CORS configuration
APP_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Rate limiting (disabled in test environment)
APP_RATE_LIMIT_DEFAULT=60/minute
APP_RATE_LIMIT_AUTH=10/minute
APP_RATE_LIMIT_UPLOAD=20/hour
APP_RATE_LIMIT_RAG=30/minute
APP_RATE_LIMIT_QA=20/minute

# Redis (optional — for distributed rate limiting and caching)
# Leave empty to use in-memory storage
APP_REDIS_URL=